# 管理面板的 nginx 配置（**模板**）
#
# 容器启动时 `20-envsubst-on-templates.sh` 会把下面这个占位符替换成环境变量：
#   - ${VIGIL_ADMIN_TOKEN}   超级管理员令牌
#
# ⚠️ 只替换这一个变量（见 compose 里的 NGINX_ENVSUBST_FILTER）。
#    不加过滤会把 `$host` / `$uri` 这些 nginx 变量当成环境变量抽成空串。
#
# ⚠️⚠️ 别在模板里写 `${VAR:+word}` 这种 shell 展开语法。
#    envsubst 只认 `${VAR}` 和 `$VAR` 两种形式 —— `${VAR:+word}` 会被原样
#    留在配置里，nginx 把它当成变量名解析，**直接启动失败**。
#    「有没有设面板密码」这个判断交给 40-vigil-auth.sh（它按需生成
#    /etc/nginx/vigil-auth.conf），模板只负责引用。

# ==========================================================
# 通道选择（http 层变量，供 location 内引用）
# ==========================================================
# 管理接口分三条通道，靠请求头区分：
#
#   A. 匿名 + 带成员令牌（vmk_） → 公开只读通道
#      不弹登录框、不注入管理员令牌，后端按 RBAC 判定。
#      只读演示令牌走的就是这条。
#
#   B. 匿名 + 无令牌            → 要求面板登录（Basic Auth）
#
#   C. 浏览器带 Basic Auth 凭据 → 校验通过后注入管理员令牌
#
# ⚠️ 判定只看「有没有 Authorization 头」，不看它对不对 ——
#    对不对由 auth_basic 在访问阶段校验；错了就是 401。
#
# 为什么 C 要优先于 A：面板所有者自己的浏览器里通常**也**存着
# 演示令牌（config.js 注入的）。如果按令牌走 A，管理员会被降级成
# 只读账号 —— 页面能开、数据能看，就是什么都改不了。
#
# ⚠️ 正则别写成 "~^\|~^vmk_"：两个 ^ 会让模式要求「vmk_ 之后又回到行首」，
#    永远匹配不上（实测踩过）。复合源拼接后是 "|vmk_xxx"，所以是 "~^\|vmk_"。
map "$http_authorization|$http_x_vigil_member_token" $vigil_public_channel {
    default       0;
    "~^\|vmk_"    1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # sourcemap 上传上限（采集服务的 bodyLimit 就是 64MB）。
    client_max_body_size 64m;

    # ==========================================================
    # SDK 上报：必须公开访问
    # ==========================================================
    # 这四条**不能** include vigil-auth.conf —— 上报来自用户的浏览器，
    # 没法带上面板的登录凭据。它们靠项目密钥（vsk_）鉴权。
    # ⚠️ 用 `=` 精确匹配：前缀匹配会把 /api/v1/collect/xxx 也放出去。
    location = /api/v1/collect      { include /etc/nginx/vigil-proxy.conf; }
    location = /api/v1/performance  { include /etc/nginx/vigil-proxy.conf; }
    location = /api/v1/behavior     { include /etc/nginx/vigil-proxy.conf; }
    location = /api/v1/sourcemaps   { include /etc/nginx/vigil-proxy.conf; }

# ==========================================================
# 管理接口：B / C 通道
# ==========================================================
    # A 通道（带 vmk_ 成员令牌且没有 Basic 凭据）走下面的
    # @vigil_public_api named location。
    #
    # ⚠️ 为什么不用 `auth_basic $var` 直接开关：nginx 只认**字面量**
    #    `off`，变量求值成 "off" 照样弹登录框（实测过）。
    #    所以用 error_page + named location 绕。
    #
    # ⚠️ named location 里 proxy_pass 会保留原始 URI 和请求体
    #    （实测：POST 的 body 完好），所以这条通道能正常写操作 ——
    #    能不能写最终由后端 RBAC 说了算，不是 nginx。
    location /api/ {
        error_page 418 = @vigil_public_api;
        if ($vigil_public_channel) {
            return 418;
        }
        # 面板登录保护。没有设 VIGIL_PANEL_PASSWORD 时，这个文件是空的
        # —— 也就是不校验（老行为：面板彻底敞开，脚本会打警告）。
        include /etc/nginx/vigil-auth.conf;
        include /etc/nginx/vigil-proxy.conf;
        # 管理员令牌：只在**通过 Basic Auth 之后**才会走到代理这一步
        # （auth_basic 在访问阶段就 401 了，代理根本不执行）。
        # 所以这里写死令牌是安全的 —— 拿不到凭据就拿不到这个头。
        proxy_set_header x-vigil-admin-token "${VIGIL_ADMIN_TOKEN}";
    }

    # ==========================================================
    # A 通道：公开只读
    # ==========================================================
    # 只有成员的读权限由后端 RBAC 保证。
    # ⚠️ 这里**不能** include vigil-auth.conf（会弹登录框），
    #    也**不能**注入管理员令牌。
    location @vigil_public_api {
        auth_basic off;
        include /etc/nginx/vigil-proxy.conf;
    }

    # ==========================================================
    # SDK 浏览器产物：必须公开
    # ==========================================================
    # 业务页面直接 <script src> 引它，不可能带面板登录凭据。
    # 文件不带 hash，所以缓存只给 1 小时 —— 给 1y immutable 的话
    # 发版后客户端会一直用旧 SDK，且没有任何办法让它们刷新。
    location /sdk/ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # ==========================================================
    # 面板静态资源：公开
    # ==========================================================
    # 访客要免登录看到面板长什么样，静态资源就不能拦。
    # 真正的数据边界在 /api（上面那三条通道）。
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 只读演示令牌（config.js）：公开。
    # 前端在 index.html 里用 <script src="/config.js"> 读它。
    location = /config.js {
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }

    # index.html 不缓存：否则发版后用户拿到的还是旧的资源引用
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # 面板是单页应用：所有前端路由回退到 index.html，由 vue-router 解析。
    # 公开访问 —— 数据层才区分匿名/成员/管理员。
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
