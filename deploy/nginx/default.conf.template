# 管理面板的 nginx 配置（**模板**）
#
# 容器启动时 `20-envsubst-on-templates.sh` 会把下面两个占位符替换成环境变量：
#   - ${VIGIL_ADMIN_TOKEN}   超级管理员令牌（只在通过 Basic Auth 后注入）
#   - ${VIGIL_PANEL_PASSWORD} 面板密码（决定是否对 /api 要求 Basic Auth）
#
# ⚠️ 只替换这两个变量（见 compose 里的 NGINX_ENVSUBST_FILTER）。
#    不加过滤会把 `$host` / `$uri` 这些 nginx 变量当成环境变量抽成空串。

# ==========================================================
# 令牌注入的两条规则（http 层变量，供 location 内引用）
# ==========================================================
# 超级管理员令牌：只有通过 Basic Auth（nginx 变量 $remote_user 非空）
# 才注入。匿名请求拿不到它 —— 否则「公开只读演示」会被当全站管理员。
map $remote_user $vigil_admin_token {
    default "";
    "~.+"   "${VIGIL_ADMIN_TOKEN}";
}

# /api 是否需要 Basic Auth：
#   - 带了成员令牌（vmk_）的请求放行，后端按 RBAC 判定（只读演示走这条）
#   - 否则按面板密码开关：设了密码 → 要求登录；没设 → 公开
map $http_x_vigil_member_token $vigil_api_auth {
    "~^vmk_" off;
    # 设了面板密码 → 要求 Basic Auth；没设 → 空串（等价于 off，公开）
    # ⚠️ 必须带引号：否则密码为空时这里会变成 `default ;` 直接报语法错
    default "${VIGIL_PANEL_PASSWORD:+Restricted}";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # sourcemap 上传上限（采集服务的 bodyLimit 就是 64MB）。
    client_max_body_size 64m;

    # ==========================================================
    # SDK 上报：必须公开访问
    # ==========================================================
    location = /api/v1/collect      { include /etc/nginx/vigil-proxy.conf; }
    location = /api/v1/performance  { include /etc/nginx/vigil-proxy.conf; }
    location = /api/v1/behavior     { include /etc/nginx/vigil-proxy.conf; }
    location = /api/v1/sourcemaps   { include /etc/nginx/vigil-proxy.conf; }

    # ==========================================================
    # 管理接口：成员令牌放行，否则要求面板登录（Basic Auth）
    # ==========================================================
    # 匿名 + 携带 vmk_ 成员令牌 → auth_basic off，后端按 RBAC 给只读/成员权限。
    # 管理员在浏览器弹出的登录框输入面板密码 → $remote_user 非空 → 注入 admin token。
    location /api/ {
        auth_basic $vigil_api_auth;
        auth_basic_user_file /etc/nginx/.htpasswd;
        include /etc/nginx/vigil-proxy.conf;
    }

    # ==========================================================
    # SDK 浏览器产物：必须公开
    # ==========================================================
    location /sdk/ {
        expires 1h;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # ==========================================================
    # 面板静态资源（**公开**，访客免登录即可加载；数据靠成员令牌只读）
    # ==========================================================
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 只读演示令牌（config.js）也公开，且不被 SPA 回退吞掉
    location = /config.js {
        add_header Cache-Control "public, max-age=300";
    }

    # index.html 不缓存：否则发版后用户拿到的还是旧的资源引用
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # 面板是单页应用：所有前端路由回退到 index.html，由 vue-router 解析。
    # 公开访问 —— 数据层才区分匿名/成员/管理员。
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
