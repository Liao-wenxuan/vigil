{
  "name": "@vigil/sdk",
  "version": "0.1.0",
  "description": "Vigil 浏览器端错误采集 SDK：错误、性能 RUM、会话回放与用户行为",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./replay": {
      "types": "./dist/replay-entry.d.ts",
      "import": "./dist/replay.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.vue.config.ts && vite build -c vite.replay.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liao-wenxuan/vigil.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Liao-wenxuan/vigil/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/Liao-wenxuan/vigil/issues"
  },
  "keywords": [
    "monitoring",
    "observability",
    "error-tracking",
    "rum",
    "session-replay",
    "web-vitals",
    "slo"
  ],
  "dependencies": {
    "@vigil/protocol": "^0.1.0"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "rrweb": "^2.2.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
