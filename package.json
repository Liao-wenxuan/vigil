{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vigil — 多应用前端错误监控平台：浏览器 SDK + 采集服务 + 管理面板",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,css,vue}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,css,vue}\"",
    "dev:collector": "npm --prefix packages/collector run dev",
    "dev:dashboard": "npm --prefix packages/dashboard run dev",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "verify": "npm run build --workspace @vigil/sdk && tsx scripts/verify-pipeline.ts",
    "verify:dashboard": "node packages/dashboard/tests/verify-dashboard.mjs --url http://localhost:5174",
    "audit:ui": "node scripts/audit-ui.mjs --url http://localhost:5174",
    "audit:plans": "tsx scripts/audit-query-plans.ts",
    "audit:ingest": "tsx scripts/audit-ingest-calls.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,vue}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
