# 管理 token —— 生产环境必须改
#
# 生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ 泄露它 = 全部错误数据泄露。生产必须走 HTTPS。
VIGIL_ADMIN_TOKEN=change-me-to-a-random-string

# ---- PostgreSQL ----
#
# 采集服务按 DATABASE_URL 选库：设了就用 PostgreSQL，没设就退回 SQLite
# （SQLite 只能单副本 —— 一个文件，多进程写会锁竞争）。
POSTGRES_USER=vigil
# 生成：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=change-me-to-a-random-string

# ---- 保留策略 ----
#
# 每隔多少秒裁一次过期数据（按每个项目的 retention_days 走）。
# 设 0 关闭 —— 关掉之后表只增不减，只在调试时用。
VIGIL_RETENTION_INTERVAL=3600

# ---- 采集服务连接池 ----
#
# 多副本部署时注意：副本数 × VIGIL_PG_POOL_MAX 必须小于 PG 的 max_connections。
VIGIL_PG_POOL_MAX=10
VIGIL_PG_STATEMENT_TIMEOUT_MS=15000
# 云数据库强制 TLS 时设 verify（校验证书）；自签证书用 no-verify；内网自建可不设
# VIGIL_PG_SSL=verify
