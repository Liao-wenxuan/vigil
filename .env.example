# 管理 token —— 生产环境必须改
#
# 生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ 泄露它 = 全部错误数据泄露。生产必须走 HTTPS。
#
# 注意：它由面板的 nginx 在**服务端**注入，不进前端 bundle，
# 也不出现在浏览器的网络面板里。
VIGIL_ADMIN_TOKEN=change-me-to-a-random-string

# ---- 面板登录（Basic Auth）----
#
# ⚠️ 不设 = 面板没有任何登录保护。
# 因为 nginx 会给每个 /api 请求自动带上管理 token，
# 「知道域名」就等于「拿到完整管理权限」。公网部署必须设。
VIGIL_PANEL_USER=admin
VIGIL_PANEL_PASSWORD=

# ---- 公开只读 Demo（可选，默认不设）----
#
# 设了之后访客免登录就能看演示数据，全程只读。
# 值由 scripts/seed-demo-member.sh 生成并写进本文件：一把 org=1 / project=1 的
# reader 成员 vmk_ 凭据；面板容器启动时由 50-vigil-demo-config.sh 写进 /config.js。
# 不设 = 没有公开只读通道，匿名访问 /api 仍要走面板登录。
# VIGIL_DEMO_MEMBER_TOKEN=

# ---- PostgreSQL ----
#
# 采集服务按 DATABASE_URL 选库：设了就用 PostgreSQL，没设就退回 SQLite
# （SQLite 只能单副本 —— 一个文件，多进程写会锁竞争）。
POSTGRES_USER=vigil
# 生成：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=change-me-to-a-random-string

# ---- 保留策略 ----
#
# 每隔多少秒裁一次过期数据（按每个项目的 retention_days 走）。
# 设 0 关闭 —— 关掉之后表只增不减，只在调试时用。
VIGIL_RETENTION_INTERVAL=3600

# ---- 采集服务连接池 ----
#
# 多副本部署时注意：副本数 × VIGIL_PG_POOL_MAX 必须小于 PG 的 max_connections。
VIGIL_PG_POOL_MAX=10
VIGIL_PG_STATEMENT_TIMEOUT_MS=15000
# 云数据库强制 TLS 时设 verify（校验证书）；自签证书用 no-verify；内网自建可不设
# VIGIL_PG_SSL=verify
